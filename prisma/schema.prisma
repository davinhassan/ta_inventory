// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- USER ---
enum Role {
  STAFF
  ADMIN
  MANAJER
  PEMILIK
}

model Pengguna {
  id             Int             @id @default(autoincrement())
  nama           String
  email          String          @unique
  password       String
  role           Role            @default(STAFF)
  transaksiStok  TransaksiStok[]
  purchaseOrders PurchaseOrder[]
  penjualan      Transaksi[]
}

// --- SUPPLIER ---
model Supplier {
  id             Int             @id @default(autoincrement())
  namaSupplier   String
  alamat         String
  telepon        String          @unique
  sukuCadang     SukuCadang[]
  purchaseOrders PurchaseOrder[]
}

// --- BARANG ---
model SukuCadang {
  id            Int               @id @default(autoincrement())
  kodeBarang    String            @unique
  namaBarang    String
  stok          Int
  minStok       Int               @default(5)
  maxStok       Int               @default(50)

  hargaBeli     Decimal           @db.Decimal(15, 2)
  hargaJual     Decimal           @db.Decimal(15, 2) @default(0)
  
  supplierId    Int?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  transaksiStok TransaksiStok[]
  detailPOs     DetailPO[]
  detailJual    DetailTransaksi[]
}

// --- BARANG MASUK (PO) ---
enum StatusPO {
  PENDING
  SELESAI
  DITOLAK
}

model PurchaseOrder {
  id           Int        @id @default(autoincrement())
  noPO         String     @unique
  tanggalPesan DateTime   @default(now())
  status       StatusPO   @default(PENDING)
  buktiFoto    String?
  supplierId   Int
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  dibuatOlehId Int
  dibuatOleh   Pengguna   @relation(fields: [dibuatOlehId], references: [id])
  items        DetailPO[]
}

model DetailPO {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sukuCadangId    Int
  sukuCadang      SukuCadang    @relation(fields: [sukuCadangId], references: [id])
  jumlah          Int
}

// --- BARANG KELUAR (TRANSAKSI) ---
model Transaksi {
  id        Int               @id @default(autoincrement())
  

  total     Decimal           @db.Decimal(15, 2)
  
  status    String            @default("LUNAS")
  tanggal   DateTime          @default(now())
  buktiFoto String?
  userId    Int
  user      Pengguna          @relation(fields: [userId], references: [id])
  detail    DetailTransaksi[]
}

model DetailTransaksi {
  id           Int        @id @default(autoincrement())
  transaksiId  Int
  transaksi    Transaksi  @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  sukuCadangId Int
  sukuCadang   SukuCadang @relation(fields: [sukuCadangId], references: [id])
  jumlah       Int
  hargaSatuan  Decimal    @db.Decimal(15, 2)
  subtotal     Decimal    @db.Decimal(15, 2)
}

// --- RIWAYAT LOG OTOMATIS ---
enum TipeTransaksi {
  MASUK
  KELUAR
}

model TransaksiStok {
  id              Int           @id @default(autoincrement())
  tanggal         DateTime      @default(now())
  tipe            TipeTransaksi
  jumlah          Int
  keterangan      String?
  sukuCadangId    Int
  sukuCadang      SukuCadang    @relation(fields: [sukuCadangId], references: [id])
  dilakukanOlehId Int
  dilakukanOleh   Pengguna      @relation(fields: [dilakukanOlehId], references: [id])
}